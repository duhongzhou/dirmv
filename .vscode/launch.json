    "configurations": [
        {
            // 一键启动调试：GUI 程序
            "name": "调试 dirMover (GUI)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Release/dirMover.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "console": "newExternalWindow",
            "preLaunchTask": "CMake: 构建 (Release)"
        },
        {
            // 调试命令行工具
            "name": "调试 dirMover_cli (命令行)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Release/dirMover_cli.exe",
            "args": [
                "scan"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "console": "integratedTerminal",
            "preLaunchTask": "CMake: 构建 (Release)"
        },
        {
            // 以 CLI 方式执行一次迁移（便于在集成终端观察输出）
            "name": "运行迁移 (CLI migrate)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Release/dirMover_cli.exe",
            "args": [
                "migrate"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "console": "integratedTerminal",
            "preLaunchTask": "CMake: 构建 (Release)"
        },
        {
            // 服务模式（需管理员；调试前请先用管理员运行 VS Code）
            "name": "调试 服务模式 (--service)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Release/dirMover.exe",
            "args": [
                "--service"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "console": "newExternalWindow",
            "preLaunchTask": "CMake: 构建 (Release)"
        },
        {
            // Debug 版本（含符号，便于断点）
            "name": "调试 dirMover (Debug)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Debug/dirMover.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "console": "newExternalWindow",
            "preLaunchTask": "CMake: 构建 (Debug)"
        }
