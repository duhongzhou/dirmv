{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: 配置",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/build",
                "-G",
                "Visual Studio 18 2026",
                "-A",
                "x64"
            ],
            "problemMatcher": []
        },
        {
            "label": "CMake: 构建 (Release)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build",
                "--config",
                "Release"
            ],
            "dependsOn": "CMake: 配置",
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "CMake: 构建 (Debug)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build",
                "--config",
                "Debug"
            ],
            "dependsOn": "CMake: 配置",
            "problemMatcher": [
                "$msCompile"
            ]
        },
        {
            "label": "CMake: 重新配置 (清缓存)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/build",
                "-G",
                "Visual Studio 18 2026",
                "-A",
                "x64",
                "--fresh"
            ],
            "problemMatcher": []
        },
        {
            "label": "运行 GUI (Release)",
            "type": "shell",
            "command": "${workspaceFolder}/build/Release/dirMover.exe",
            "dependsOn": "CMake: 构建 (Release)",
            "problemMatcher": []
        },
        {
            "label": "运行 CLI: scan",
            "type": "shell",
            "command": "${workspaceFolder}/build/Release/dirMover_cli.exe",
            "args": [
                "scan"
            ],
            "dependsOn": "CMake: 构建 (Release)",
            "problemMatcher": []
        },
        {
            "label": "运行 CLI: migrate",
            "type": "shell",
            "command": "${workspaceFolder}/build/Release/dirMover_cli.exe",
            "args": [
                "migrate"
            ],
            "dependsOn": "CMake: 构建 (Release)",
            "problemMatcher": []
        },
        {
            "label": "生成安装包 (MSI)",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/installer/build_installer.ps1",
                "-Config",
                "Release"
            ],
            "dependsOn": "CMake: 构建 (Release)",
            "problemMatcher": [],
            "group": "build"
        },
        {
            "label": "生成安装包 (MSI, 指定版本)",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/installer/build_installer.ps1",
                "-Config",
                "Release",
                "-Version",
                "${input:installerVersion}"
            ],
            "dependsOn": "CMake: 构建 (Release)",
            "problemMatcher": [],
            "group": "build"
        },
        {
            "label": "打开安装包输出目录",
            "type": "shell",
            "command": "explorer.exe",
            "args": [
                "${workspaceFolder}/installer/dist"
            ],
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "installerVersion",
            "type": "promptString",
            "description": "安装包版本号 (例如 1.0.0)",
            "default": "1.0.0"
        }
    ]
}