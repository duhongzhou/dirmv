#include <windows.h>
#include "resource.h"

/////////////////////////////////////////////////////////////////////////////
// 图标：使用 assets\dirmv.ico（由 CMake 通过 DIRMV_ICON 宏指定路径）
#ifndef IDI_APPICON
#define IDI_APPICON 101
#endif

#ifndef DIRMV_ICON
#define DIRMV_ICON "dirmv.ico"
#endif

IDI_APPICON ICON DIRMV_ICON

/////////////////////////////////////////////////////////////////////////////
// 版本信息
VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1,4,1,0
 PRODUCTVERSION 1,4,1,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",      "dirMover"
            VALUE "FileDescription",  "目录软链接迁移/恢复工具"
            VALUE "FileVersion",      "1.4.1.0"
            VALUE "InternalName",     "dirMover"
            VALUE "LegalCopyright",   "Copyright (C) 2026"
            VALUE "OriginalFilename", "dirMover.exe"
            VALUE "ProductName",      "dirMover"
            VALUE "ProductVersion",   "1.4.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
